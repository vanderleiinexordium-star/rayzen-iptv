{
  "cli": { "version": ">= 5.2.0" },
  "build": {
    "preview-phone": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "preview-android-tv": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_TV": "1" },
      "android": { "buildType": "apk" }
    },
    "production-phone": {
      "channel": "production",
      "android": { "buildType": "app-bundle" }
    },
    "production-android-tv": {
      "channel": "production",
      "env": { "EXPO_TV": "1" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
